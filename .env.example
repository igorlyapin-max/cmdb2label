NODE_ENV=production
CMDB_LABELS_HOST=127.0.0.1
CMDB_LABELS_PORT=8094
CMDBUILD_ORIGIN=http://127.0.0.1:8090
CMDB_LABELS_CSRF_SECRET=change-me-to-a-stable-secret-from-secret-store
CMDB_LABELS_DIAGNOSTIC_MODE=off
CMDB_LABELS_LOG_LEVEL=info
CMDB_LABELS_LOG_FORMAT=json
CMDB_LABELS_LOG_TARGET=stdout,syslog
CMDB_LABELS_SYSLOG_HOST=127.0.0.1
CMDB_LABELS_SYSLOG_PORT=514
CMDB_LABELS_SYSLOG_PROTOCOL=udp
CMDB_LABELS_SYSLOG_FACILITY=local0
CMDB_LABELS_MAX_RESOLVE_DEVICES=100
CMDB_LABELS_ALIAS_CONFIG_FILE=/etc/cmdb2label/aliases.json
